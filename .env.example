# =============================================================================
# Hybrid Inference Configuration
# =============================================================================
# Priority 1: OpenAI Cloud (if valid API key exists)
# Priority 2: Local Ollama (automatic fallback)
# =============================================================================

# OpenAI API Key (optional - leave empty to use local Ollama only)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI Model (default: gpt-4o-mini for cost efficiency)
OPENAI_MODEL=gpt-5-mini

# =============================================================================
# Local Ollama Configuration (Fallback)
# =============================================================================

# Ollama Base URL (inside Docker network)
OLLAMA_BASE_URL=http://ollama:11434/v1

# Local Model Name
LOCAL_MODEL=qwen2.5:1.5b

# Timeout for API calls (seconds)
API_TIMEOUT=300.0

# =============================================================================
# Debug Settings
# =============================================================================

# Force local mode (set to "true" to skip OpenAI even if key exists)
FORCE_LOCAL=false

# Enable debug logging
DEBUG=false
